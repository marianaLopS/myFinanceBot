# Copia este archivo a .env y completa tus valores.
# .env NO se sube a GitHub (está en .gitignore).

# Token que entrega @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# Tu ID numérico de Telegram. Solo este usuario puede usar el bot.
TELEGRAM_OWNER_ID=

# Ruta al JSON de la cuenta de servicio de Google
GOOGLE_CREDENTIALS_FILE=credentials.json

# ID de tu copia de la plantilla (la parte entre /d/ y /edit en la URL)
GOOGLE_SHEET_ID=

# Proveedor de IA: gemini | claude | ollama
AI_PROVIDER=gemini

# Clave según el proveedor elegido
GEMINI_API_KEY=
# Modelo de Gemini a usar
GEMINI_MODEL=gemini-3-flash-preview
ANTHROPIC_API_KEY=

# Zona horaria para fechas
TIMEZONE=America/Bogota
